{
  "manifest_version": 3,
  "name": "Everything MD",
  "version": "1.2",
  "description": "A full-featured universal Markdown manager and Gemini exporter.",
  "permissions": ["activeTab", "downloads", "scripting", "storage", "unlimitedStorage"],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "everything-md@nyaaorick.com",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}